# Use standard 4MB dual-OTA + filesystem partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="default.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Arduino-as-IDF-component requires 1 kHz FreeRTOS tick
CONFIG_FREERTOS_HZ=1000
CONFIG_AUTOSTART_ARDUINO=y

# Rollback safety: new image must confirm itself on first boot
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Keep build deterministic even outside a git repository
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="1.0.0"
